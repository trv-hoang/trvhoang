{
  "name": "trhoag",
  "version": "1.0.0",
  "scripts": {
    "dev": "npx concurrently \"npm run dev:hugo\" \"npm run dev:tailwind\"",
    "dev:hugo": "hugo server -D -p 1315",
    "dev:tailwind": "npx @tailwindcss/cli -i ./assets/css/main.css -o ./static/global.css --watch",
    "build": "npx @tailwindcss/cli -i ./assets/css/main.css -o ./static/global.css --minify && hugo --gc --minify",
    "place:add": "node scripts/places.mjs add",
    "place:check": "node scripts/places.mjs check",
    "place:sync": "node scripts/places.mjs sync",
    "map:styles": "node scripts/map-styles.mjs",
    "place:photo": "node scripts/places.mjs photo",
    "test": "node --test --test-concurrency=1 \"tests/*.test.mjs\""
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.0.0"
  }
}
